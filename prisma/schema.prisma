generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String?                @unique
  emailVerified         DateTime?
  image                 String?
  accounts              Account[]
  sessions              Session[]
  memberships           OrganizationMember[]
  auditLogs             AuditLog[]             @relation("AuditActor")
  submittedApplications VolunteerApplication[] @relation("SubmittedApplications")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ✅ Persist selected org in DB session
  currentOrgId String?
  currentOrg   Organization? @relation(fields: [currentOrgId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([currentOrgId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ApplicationStatusToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Organization {
  id                String                 @id @default(cuid())
  name              String
  slug              String                 @unique
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  members           OrganizationMember[]
  auditLogs         AuditLog[]
  featureFlags      FeatureFlag[]
  applications      VolunteerApplication[]
  screenerQuestions ScreenerQuestion[]
  sessions          Session[] // optional backrelation
  invitations       OrganizationInvitation[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           Role     @default(STAFF)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  orgId      String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
}

model FeatureFlag {
  id        String   @id @default(cuid())
  orgId     String
  key       String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
}

model VolunteerApplication {
  id                String            @id @default(cuid())
  orgId             String
  submittedByUserId String?
  submittedByEmail  String
  status            ApplicationStatus @default(SUBMITTED)
  screeningStatus   ScreeningStatus   @default(REVIEW)
  screeningReasons  Json              @default("[]")
  submittedAt       DateTime          @default(now())

  organization    Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  submittedByUser User?             @relation("SubmittedApplications", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  answers         VolunteerAnswer[]

  @@index([orgId, status])
  @@index([submittedByUserId])
}

model VolunteerAnswer {
  id            String @id @default(cuid())
  applicationId String
  questionId    String
  answerJson    Json

  application VolunteerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model ScreenerQuestion {
  id               String               @id @default(cuid())
  orgId            String
  key              String
  prompt           String
  type             ScreenerQuestionType
  disqualifierJson Json?
  configJson       Json
  isActive         Boolean              @default(true)
  order            Int
  createdAt        DateTime             @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@index([orgId, isActive, order])
}

enum ApplicationStatus {
  SUBMITTED
  REVIEW
  APPROVED
  REJECTED
}

enum ScreeningStatus {
  PASS
  REVIEW
  FAIL
}

enum ScreenerQuestionType {
  TEXT
  SINGLE_CHOICE
  MULTI_CHOICE
  BOOLEAN
  NUMBER
}

model OrganizationInvitation {
  id        String    @id @default(cuid())
  orgId     String
  email     String
  role      Role      @default(STAFF)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([orgId])
  @@index([expiresAt])
}

enum Role {
  OWNER
  ADMIN
  STAFF
  READONLY
}
