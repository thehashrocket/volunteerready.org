// Phase 12 — Concierge Activation Engine
// ---------------------------------------------------------------------------

enum OrgFeedbackType {
  DAY_7
  DAY_30
}

/// Structured feedback from concierge orgs at day 7 and day 30.
/// The combination of (orgId, type) serves as an idempotency key —
/// skip sending if a record already exists for this org + feedback type.
model OrgFeedback {
  id        String          @id @default(cuid())
  orgId     String
  type      OrgFeedbackType
  sentAt    DateTime        @default(now())
  responses Json? // Submitted survey responses (null = sent but not yet completed)
  createdAt DateTime        @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, type])
  @@index([orgId])
}

/// Key-value store for reference data version tracking.
/// Used by the boot guard to detect whether seeded data is current.
model ReferenceDataMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

