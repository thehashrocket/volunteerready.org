generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String?                @unique
  emailVerified         DateTime?
  image                 String?
  accounts              Account[]
  sessions              Session[]
  memberships           OrganizationMember[]
  companyMemberships    CompanyMember[]
  auditLogs             AuditLog[]             @relation("AuditActor")
  submittedApplications VolunteerApplication[] @relation("SubmittedApplications")
  volunteerSkills       VolunteerSkill[]
  profile               VolunteerProfile?
  credentials             VolunteerCredential[]
  shiftSignups            ShiftSignup[]
  backgroundCheckRequests BackgroundCheckRequest[]
  createdShareTokens      CredentialShareToken[]
  receivedInvitations     VolunteerInvitation[]   @relation("ReceivedInvitations")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  digestPreferences       UserDigestPreference[]
  bulkImportJobs          BulkImportJob[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ✅ Persist selected org in DB session
  currentOrgId String?
  currentOrg   Organization? @relation(fields: [currentOrgId], references: [id], onDelete: SetNull)

  // ✅ Persist selected company in DB session
  currentCompanyId String?
  currentCompany   CompanyAccount? @relation(fields: [currentCompanyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([currentOrgId])
  @@index([currentCompanyId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ApplicationStatusToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Organization {
  id                          String                   @id @default(cuid())
  name                        String
  slug                        String                   @unique
  planTier                    PlanTier                 @default(FREE)
  stripeCustomerId            String?                  @unique
  stripeSubscriptionId        String?                  @unique
  trialEndsAt                 DateTime?
  // Checkr Partner API — per-org OAuth credentials
  checkrAccessToken           String?                  // OAuth access token; store server-side only
  checkrAccountId             String?                  @unique // Checkr account ID for webhook routing
  // Phase 9 — Onboarding & activation
  onboardingProgress          Json?                    // Wizard + checklist shared state
  onboardingDismissedAt       DateTime?                // Checklist dismissed
  firstApplicationReceivedAt  DateTime?                // First-volunteer celebration trigger
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  members              OrganizationMember[]
  auditLogs            AuditLog[]
  featureFlags         FeatureFlag[]
  applications         VolunteerApplication[]
  screenerQuestions    ScreenerQuestion[]
  sessions             Session[] // optional backrelation
  invitations          OrganizationInvitation[]
  opportunities        VolunteerOpportunity[]
  credentials             VolunteerCredential[]
  sharedCredentials       VolunteerCredential[]    @relation("SharedCredentials")
  claimedShareTokens      CredentialShareToken[]   @relation("ClaimedShareTokens")
  shifts                  Shift[]
  shiftTemplates          ShiftTemplate[]
  companyLinks            CompanyNonprofitLink[]
  backgroundCheckRequests BackgroundCheckRequest[]
  volunteerInvitations    VolunteerInvitation[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  digestPreferences       UserDigestPreference[]
  bulkImportJobs          BulkImportJob[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           Role     @default(STAFF)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  orgId      String?
  companyId  String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  organization   Organization?   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  companyAccount CompanyAccount? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor          User?           @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
}

model FeatureFlag {
  id        String   @id @default(cuid())
  orgId     String
  key       String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
}

model VolunteerApplication {
  id                String            @id @default(cuid())
  orgId             String
  opportunityId     String?
  submittedByUserId String?
  submittedByEmail  String
  status            ApplicationStatus @default(SUBMITTED)
  screeningStatus   ScreeningStatus   @default(REVIEW)
  screeningReasons  Json              @default("[]")
  submittedAt       DateTime          @default(now())

  organization    Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  opportunity     VolunteerOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  submittedByUser User?                 @relation("SubmittedApplications", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  answers         VolunteerAnswer[]

  @@index([orgId, status])
  @@index([submittedByUserId])
  @@index([opportunityId])
}

model VolunteerAnswer {
  id            String @id @default(cuid())
  applicationId String
  questionId    String
  answerJson    Json

  application VolunteerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model ScreenerQuestion {
  id               String               @id @default(cuid())
  orgId            String
  key              String
  prompt           String
  type             ScreenerQuestionType
  disqualifierJson Json?
  configJson       Json
  isActive         Boolean              @default(true)
  order            Int
  createdAt        DateTime             @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@index([orgId, isActive, order])
}

enum ApplicationStatus {
  SUBMITTED
  REVIEW
  APPROVED
  REJECTED
}

enum ScreeningStatus {
  PASS
  REVIEW
  FAIL
}

enum ScreenerQuestionType {
  TEXT
  SINGLE_CHOICE
  MULTI_CHOICE
  BOOLEAN
  NUMBER
}

model OrganizationInvitation {
  id        String    @id @default(cuid())
  orgId     String
  email     String
  role      Role      @default(STAFF)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([orgId])
  @@index([expiresAt])
}

enum Role {
  OWNER
  ADMIN
  STAFF
  READONLY
}

enum OpportunityStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum RequirementLevel {
  REQUIRED
  PREFERRED
}

model VolunteerOpportunity {
  id              String            @id @default(cuid())
  orgId           String
  title           String
  description     String
  status          OpportunityStatus @default(DRAFT)
  location        String?
  isRemote        Boolean           @default(false)
  startDate       DateTime?
  endDate         DateTime?
  commitmentHours Float?
  capacity        Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization          Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tags                  OpportunityTag[]
  requirements          OpportunityRequirement[]
  applications          VolunteerApplication[]
  shifts                Shift[]
  shiftTemplates        ShiftTemplate[]
  volunteerInvitations  VolunteerInvitation[]

  @@index([orgId])
  @@index([status])
}

model OpportunityTag {
  id            String               @id @default(cuid())
  opportunityId String
  name          String

  opportunity VolunteerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, name])
  @@index([opportunityId])
}

model OpportunityRequirement {
  id            String           @id @default(cuid())
  opportunityId String
  skillId       String?
  familyId      String?
  level         RequirementLevel @default(REQUIRED)

  opportunity VolunteerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  skill       Skill?               @relation(fields: [skillId], references: [id], onDelete: Cascade)
  family      SkillFamily?         @relation(fields: [familyId], references: [id], onDelete: Cascade)

  // Partial unique indexes added via raw SQL in migration (nullable FKs)
  @@index([opportunityId])
  @@index([skillId])
  @@index([familyId])
}

model SkillFamily {
  id           String                   @id @default(cuid())
  name         String                   @unique
  slug         String                   @unique
  skills       Skill[]
  requirements OpportunityRequirement[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
}

model Skill {
  id              String                   @id @default(cuid())
  name            String                   @unique
  slug            String                   @unique
  familyId        String
  family          SkillFamily              @relation(fields: [familyId], references: [id])
  volunteerSkills VolunteerSkill[]
  requirements    OpportunityRequirement[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([familyId])
}

model VolunteerSkill {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@unique([userId, skillId])
  @@index([userId])
}

model VolunteerProfile {
  id           String             @id @default(cuid())
  userId       String             @unique
  bio          String?
  phone        String?
  city         String?
  state        String?
  country      String?
  availability AvailabilityType   @default(FLEXIBLE)
  visibility   ProfileVisibility  @default(ORGS_ONLY)
  interests    String[]           @default([])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Phase 7 — indexes for volunteer discovery search
  @@index([visibility])
  @@index([city, state])
}

enum AvailabilityType {
  WEEKDAYS
  WEEKENDS
  EVENINGS
  FLEXIBLE
}

enum ProfileVisibility {
  PUBLIC
  ORGS_ONLY
  PRIVATE
}

model VolunteerCredential {
  id                     String           @id @default(cuid())
  userId                 String
  orgId                  String
  type                   CredentialType
  status                 CredentialStatus @default(PENDING)
  issuedAt               DateTime?
  expiresAt              DateTime?
  notes                  String?
  issuedById             String?
  // Phase 6C — provenance: tracks origin when credential was shared from another org
  sharedFromOrgId        String?
  sharedFromCredentialId String?
  // Phase 6C — forward-prep for expiry notification cron (Phase 7)
  notifiedAt             DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization           Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sharedFromOrg          Organization?           @relation("SharedCredentials", fields: [sharedFromOrgId], references: [id], onDelete: SetNull)
  backgroundCheckRequest BackgroundCheckRequest?
  shareTokens            CredentialShareToken[]

  @@unique([userId, orgId, type])
  @@index([userId])
  @@index([orgId])
  // Phase 7 — index for volunteer discovery (filter by verified credentials)
  @@index([userId, status])
}

enum CredentialType {
  BACKGROUND_CHECK
  TRAINING_COMPLETE
  ID_VERIFIED
  REFERENCE_CHECK
  ORIENTATION_COMPLETE
  // Phase 7 — Tenure badges (issued by platform org)
  TENURE_1YR
  TENURE_3YR
  TENURE_5YR
}

enum CredentialStatus {
  PENDING
  VERIFIED
  EXPIRED
  REVOKED
}

// ---------------------------------------------------------------------------
// Phase 5 — Scheduling & Shifts
// ---------------------------------------------------------------------------

model ShiftTemplate {
  id            String    @id @default(cuid())
  orgId         String
  title         String
  description   String?
  location      String?
  isRemote      Boolean   @default(false)
  dayOfWeek     Int       // 0=Sunday, 1=Monday, ..., 6=Saturday
  startHour     Int       // 0-23
  startMinute   Int       // 0-59
  endHour       Int       // 0-23
  endMinute     Int       // 0-59
  capacity      Int
  opportunityId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organization Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  opportunity  VolunteerOpportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  shifts       Shift[]

  @@index([orgId])
}

model Shift {
  id            String         @id @default(cuid())
  orgId         String
  opportunityId String?
  templateId    String?
  title         String
  description   String?
  location      String?
  isRemote      Boolean        @default(false)
  startTime     DateTime
  endTime       DateTime
  capacity      Int
  status        ShiftStatus    @default(OPEN)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  organization Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  opportunity  VolunteerOpportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  template     ShiftTemplate?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  signups      ShiftSignup[]

  @@index([orgId])
  @@index([opportunityId])
  @@index([templateId])
  @@index([orgId, startTime])
  @@index([status])
}

enum ShiftStatus {
  OPEN
  FULL
  CANCELLED
  COMPLETED
}

model ShiftSignup {
  id              String       @id @default(cuid())
  shiftId         String
  userId          String
  status          SignupStatus  @default(CONFIRMED)
  notes           String?
  reminderSentAt  DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shiftId, userId])
  @@index([shiftId])
  @@index([userId])
}

enum SignupStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
  NO_SHOW
  ATTENDED
}

// ---------------------------------------------------------------------------
// Phase 6A — Employer Accounts & Billing
// ---------------------------------------------------------------------------

enum PlanTier {
  FREE
  STARTER
  PRO
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum CompanyNonprofitLinkStatus {
  ACTIVE
  PAUSED
}

model CompanyAccount {
  id                   String                 @id @default(cuid())
  name                 String
  slug                 String                 @unique
  stripeCustomerId     String?                @unique
  stripeSubscriptionId String?                @unique
  planTier             PlanTier               @default(FREE)
  trialEndsAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  members              CompanyMember[]
  invitations          CompanyInvitation[]
  nonprofitLinks       CompanyNonprofitLink[]
  sessions             Session[]
  auditLogs            AuditLog[]
}

model CompanyMember {
  id        String            @id @default(cuid())
  companyId String
  userId    String
  role      CompanyMemberRole @default(MEMBER)
  createdAt DateTime          @default(now())

  company CompanyAccount @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
}

model CompanyInvitation {
  id        String            @id @default(cuid())
  companyId String
  email     String
  role      CompanyMemberRole @default(MEMBER)
  tokenHash String            @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  company CompanyAccount @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([companyId])
  @@index([expiresAt])
}

model CompanyNonprofitLink {
  id        String                     @id @default(cuid())
  companyId String
  orgId     String
  status    CompanyNonprofitLinkStatus @default(ACTIVE)
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  company CompanyAccount @relation(fields: [companyId], references: [id], onDelete: Cascade)
  org     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([companyId, orgId])
  @@index([companyId])
  @@index([orgId])
}

model StripeWebhookEvent {
  id          String   @id @default(cuid())
  stripeId    String   @unique // evt_... — idempotency key; UNIQUE constraint is the safety net
  type        String
  processedAt DateTime @default(now())
  payload     Json
}

// ---------------------------------------------------------------------------
// Phase 6B — Background Check Integration
// ---------------------------------------------------------------------------

enum BackgroundCheckProvider {
  CHECKR
  STERLING
}

enum BackgroundCheckStatus {
  PENDING
  COMPLETE
  CONSIDER
  FAILED
  CANCELLED
}

enum FcraStatus {
  NONE
  PRE_ADVERSE_SENT
  ADVERSE_ACTION_SENT
  RESOLVED
}

model BackgroundCheckRequest {
  id                      String                  @id @default(cuid())
  orgId                   String
  userId                  String
  provider                BackgroundCheckProvider @default(CHECKR)
  externalId              String                  @unique // Checkr report ID — idempotency key
  status                  BackgroundCheckStatus   @default(PENDING)
  webhookPayload          Json? // sanitized (no PII fields)
  credentialId            String?                 @unique
  fcraStatus              FcraStatus              @default(NONE)
  preAdverseNoticeSentAt  DateTime?
  adverseActionAt         DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  organization Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential   VolunteerCredential?  @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([userId])
  @@index([orgId, status])
}

model CheckrWebhookEvent {
  id          String   @id @default(cuid())
  checkrId    String   @unique // idempotency key — mirrors StripeWebhookEvent.stripeId
  type        String
  processedAt DateTime @default(now())
  payload     Json // sanitized (no PII fields)
}

// ---------------------------------------------------------------------------
// Phase 6C — Portable Credential Sharing
// ---------------------------------------------------------------------------

enum ShareTokenStatus {
  ACTIVE
  CLAIMED
  EXPIRED
}

model CredentialShareToken {
  id              String           @id @default(cuid())
  credentialId    String
  createdByUserId String
  tokenHash       String           @unique
  expiresAt       DateTime
  claimedByOrgId  String?
  claimedAt       DateTime?
  status          ShareTokenStatus @default(ACTIVE)
  notifiedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  credential   VolunteerCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  createdBy    User                @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  claimedByOrg Organization?       @relation("ClaimedShareTokens", fields: [claimedByOrgId], references: [id], onDelete: SetNull)

  @@index([credentialId])
  @@index([createdByUserId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Phase 7 — Network Growth & Volunteer Identity
// ---------------------------------------------------------------------------

model VolunteerInvitation {
  id            String   @id @default(cuid())
  orgId         String
  volunteerId   String
  opportunityId String
  sentAt        DateTime @default(now())
  createdAt     DateTime @default(now())

  organization Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  volunteer    User                 @relation("ReceivedInvitations", fields: [volunteerId], references: [id], onDelete: Cascade)
  opportunity  VolunteerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([orgId, volunteerId, opportunityId])
  @@index([orgId, sentAt])
  @@index([volunteerId, sentAt])
}

// ---------------------------------------------------------------------------
// Phase 8 — Notifications & Preferences
// ---------------------------------------------------------------------------

enum NotificationType {
  SHIFT_REMINDER
  SHIFT_CANCELLED
  SHIFT_UPDATED
  APPLICATION_STATUS
  CREDENTIAL_EXPIRY
  TEAM_ANNOUNCEMENT
  WAITLIST_PROMOTED
  NEW_OPPORTUNITY
  BADGE_EARNED
  FIRST_APPLICATION
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  orgId     String
  type      NotificationType
  title     String
  body      String
  href        String?
  readAt      DateTime?
  emailSentAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([orgId])
  @@index([deletedAt])
}

model NotificationPreference {
  id      String           @id @default(cuid())
  userId  String
  orgId   String
  type    NotificationType
  inApp   Boolean          @default(true)
  email   Boolean          @default(true)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId, type])
  @@index([userId, orgId])
}

// ---------------------------------------------------------------------------
// Phase 9 — Production-Ready Infrastructure
// ---------------------------------------------------------------------------

enum CronJobStatus {
  SUCCESS
  FAILURE
}

model CronJobRun {
  id            String        @id @default(cuid())
  jobName       String
  startedAt     DateTime      @default(now())
  completedAt   DateTime?
  status        CronJobStatus
  resultSummary Json?
  durationMs    Int?
  error         String?
  createdAt     DateTime      @default(now())

  @@index([jobName, startedAt])
}

enum DigestFrequency {
  OFF
  DAILY
  WEEKLY
}

model UserDigestPreference {
  id               String          @id @default(cuid())
  userId           String
  orgId            String
  digestFrequency  DigestFrequency @default(WEEKLY)
  lastDigestSentAt DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([digestFrequency, lastDigestSentAt])
}

enum BulkImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model BulkImportJob {
  id           String           @id @default(cuid())
  orgId        String
  uploadedById String
  status       BulkImportStatus @default(PENDING)
  totalRows    Int              @default(0)
  processedRows Int             @default(0)
  createdRows  Int              @default(0)
  skippedRows  Int              @default(0)
  errorRows    Json?            // Array of { row: number, error: string }
  fileName     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([uploadedById])
}
