// ---------------------------------------------------------------------------
// Staff-Created Volunteers (v1a) — see docs/designs/staff-created-volunteers.md
// ---------------------------------------------------------------------------

enum AccountState {
  ACTIVE // default; every pre-existing user backfills to this
  UNCLAIMED // created by org staff; no one has ever authenticated
}

enum OrgVolunteerSource {
  STAFF_ADDED // typed into the roster by a coordinator
  APPLIED // materialized from an approved VolunteerApplication (E1a)
}

/// The org-to-volunteer edge. Deliberately NOT modeled as a VolunteerApplication
/// with source: STAFF_ADDED — that variant has no dedup (the applications partial
/// unique index requires a non-null opportunityId, which a roster row lacks), it
/// leaks into both the staff review queue and the volunteer's /app/my-applications,
/// and it collides with bulk-import's findFirst({ orgId, submittedByEmail }) dedup.
///
///   Organization ──< OrgVolunteer >── User
///                         │
///                    addedBy (User?, SetNull)
///
/// Removal is a SOFT delete: deletedAt is set, ShiftSignup rows are untouched, and
/// the org keeps every hour it recorded. Undo (T26) clears deletedAt on the same
/// row, which preserves addedByUserId/createdAt provenance that a re-add would lose.
model OrgVolunteer {
  id            String             @id @default(cuid())
  orgId         String
  userId        String
  displayName   String // org-typed name, max 120 chars (validated in Zod, not here)
  phone         String? // org-typed. Deliberately NOT duplicated onto VolunteerProfile,
  // which is for what the volunteer sets themselves after claiming.
  source        OrgVolunteerSource @default(STAFF_ADDED)
  addedByUserId String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedBy      User?        @relation("OrgVolunteerAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)

  // NO @@unique([orgId, userId]) — uniqueness is a hand-written PARTIAL index
  // (WHERE "deletedAt" IS NULL) so a soft-deleted row does not block re-adding
  // the same volunteer. Prisma cannot see raw partial indexes, so the generated
  // compound-unique input does not exist and upsert/findUnique on the pair are
  // unavailable BY DESIGN. Use findFirst({ orgId, userId, deletedAt: null })
  // then create, catching P2002 for the concurrent case. Postgres still raises
  // 23505 on a partial unique index and Prisma still maps it to P2002.
  // Precedent: VolunteerApplication's withdrawn-status partial index.
  @@index([orgId, createdAt]) // cursor pagination on the roster page
  @@index([userId])
}

/// A volunteer's standing refusal of one org's access to them.
///
/// Written when a volunteer leaves a roster (`leaveOrgRoster`). It exists
/// because every OTHER edge in `findOrgVolunteerRelationship` is one the org can
/// mint unilaterally: `addVolunteer` takes an email and needs no consent, so
/// soft-deleting the `OrgVolunteer` row alone left the volunteer with no state
/// the org could not simply recreate — two clicks and the access was back. A
/// consent mechanism the other party can undo is not one. This row is the only
/// piece of state in the org↔volunteer relationship that staff cannot clear.
///
/// Deliberately a HARD row with no `deletedAt`: lifting a block means the
/// volunteer re-engaged of their own accord (applied, claimed an application, or
/// signed up for a shift), and the history of the block lives in the audit log
/// as `VOLUNTEER_LEFT` / `ORG_ACCESS_RESTORED` rather than in a tombstone here.
///
/// A block suppresses the volunteer-side relationship kinds but NOT
/// `ORG_MEMBER` — see `findOrgVolunteerRelationship`, which would otherwise let
/// a person who is both staff and a rostered volunteer lock themselves out of
/// their own organization by leaving its roster.
model OrgVolunteerBlock {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A plain compound unique, unlike OrgVolunteer's hand-written PARTIAL index:
  // there is no soft delete here, so "at most one block per (org, user)" is the
  // whole rule and Prisma can express it. That also makes the generated
  // compound-unique input available, so the lift path is a single deleteMany
  // and the create is an upsert — neither needs the findFirst-then-create
  // dance OrgVolunteer requires.
  @@unique([orgId, userId])
  @@index([userId])
}
