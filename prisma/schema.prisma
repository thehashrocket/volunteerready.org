generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                     @id @default(cuid())
  name                    String?
  /// NORMALIZED AT THE DATABASE — invisible to Prisma. A BEFORE INSERT/UPDATE
  /// trigger (`trg_user_email_normalize`, migration 20260726231500) lowercases
  /// and trims every write, and a functional unique index
  /// (`User_email_lower_key`) enforces case-insensitive uniqueness even if the
  /// trigger is ever dropped. Storage is therefore ALWAYS lowercase.
  ///
  /// Consequence: `create()`/`update()` return the value you passed, not the
  /// value stored. Re-read the row if you need the canonical form. Lowercase
  /// your input before `findUnique({ where: { email } })`.
  ///
  /// Why a trigger and not service-layer lowercasing: NextAuth's PrismaAdapter
  /// (auth.ts:26) writes User rows without passing through any service, so a
  /// service-layer fix would miss the largest write path in the app and the
  /// unclaimed-email guard would keep failing open.
  email                   String?                    @unique
  emailVerified           DateTime?
  image                   String?
  accounts                Account[]
  sessions                Session[]
  memberships             OrganizationMember[]
  companyMemberships      CompanyMember[]
  auditLogs               AuditLog[]                 @relation("AuditActor")
  submittedApplications   VolunteerApplication[]     @relation("SubmittedApplications")
  declinedApplications    VolunteerApplication[]     @relation("DeclinedApplications")
  volunteerSkills         VolunteerSkill[]
  profile                 VolunteerProfile?
  credentials             VolunteerCredential[]
  shiftSignups            ShiftSignup[]
  backgroundCheckRequests BackgroundCheckRequest[]
  createdShareTokens      CredentialShareToken[]
  receivedInvitations     VolunteerInvitation[]      @relation("ReceivedInvitations")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  digestPreferences       UserDigestPreference[]
  interests               OpportunityInterest[]
  marketplacePreference   UserMarketplacePreference?
  bulkImportJobs          BulkImportJob[]
  isPlatformAdmin         Boolean                    @default(false)
  feedbacks               UserFeedback[]
  resolvedFeedbacks       UserFeedback[]             @relation("FeedbackResolver")
  repliedFeedbacks        UserFeedback[]             @relation("FeedbackReplier")
  impersonationsAsAdmin   ImpersonationSession[]     @relation("ImpersonationAdmin")
  impersonationsAsTarget  ImpersonationSession[]     @relation("ImpersonationTarget")
  suspendedOrgs           Organization[]             @relation("OrgSuspendedBy")
  updatedFeatureFlags     FeatureFlag[]              @relation("FeatureFlagUpdatedBy")
  // Staff-created volunteers. An UNCLAIMED User is a real row nobody has ever
  // authenticated as. Claiming is a state flip, not a data migration, so
  // ShiftSignup / VolunteerCredential / VolunteerProfile keep their userId FK
  // and every hours + impact report works over shadow users with no query change.
  accountState            AccountState               @default(ACTIVE)
  claimedAt               DateTime? // stamped on first authenticated session
  orgVolunteers           OrgVolunteer[]
  addedOrgVolunteers      OrgVolunteer[]             @relation("OrgVolunteerAddedBy")
  orgVolunteerBlocks      OrgVolunteerBlock[]
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ✅ Persist selected org in DB session
  currentOrgId String?
  currentOrg   Organization? @relation(fields: [currentOrgId], references: [id], onDelete: SetNull)

  // ✅ Persist selected company in DB session
  currentCompanyId String?
  currentCompany   CompanyAccount? @relation(fields: [currentCompanyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([currentOrgId])
  @@index([currentCompanyId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ApplicationStatusToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Organization {
  id                         String                   @id @default(cuid())
  name                       String
  slug                       String                   @unique
  planTier                   PlanTier                 @default(FREE)
  stripeCustomerId           String?                  @unique
  stripeSubscriptionId       String?                  @unique
  trialEndsAt                DateTime?
  // Checkr Partner API — per-org OAuth credentials
  checkrAccessToken          String? // OAuth access token; store server-side only
  checkrAccountId            String?                  @unique // Checkr account ID for webhook routing
  // Sterling — per-org API key (pasted by admin, encrypted at rest)
  sterlingApiKey             String? // Encrypted AES-256-GCM (same as Checkr token)
  sterlingAccountId          String?                  @unique // Sterling account ID for webhook routing
  // Phase 9 — Onboarding & activation
  onboardingProgress         Json? // Wizard + checklist shared state
  onboardingDismissedAt      DateTime? // Checklist dismissed
  firstApplicationReceivedAt DateTime? // First-volunteer celebration trigger
  qrForegroundColor          String? // Custom QR code color (hex, e.g. #1B3C2A)
  timezone                   String? // IANA timezone (e.g. "America/New_York"). NULL = UTC.
  // Phase 12 — Concierge Activation Engine
  onboardingBaseline         Json? // Baseline data captured at concierge onboarding
  showPoweredBy              Boolean                  @default(true) // "Powered by VolunteerReady" footer on apply pages
  onboardingComplete         Boolean                  @default(false) // Onboarding checklist dismissed
  referralSource             String? // Referral tracking (orgSlug of referring org)
  // Content Flywheel — case study consent + org branding
  consentToPublicize         Boolean                  @default(false) // Org consented to public case study
  logoUrl                    String? // Org logo (Vercel Blob URL)
  // Tier 3 — platform admin suspension (freeze tenant without delete)
  suspendedAt                DateTime? // NULL = active; non-NULL = suspended
  suspendedReason            String? // Free-text justification (audit-redundant but UI-handy)
  suspendedById              String? // Platform admin who suspended (FK to User)
  suspendedBy                User?                    @relation("OrgSuspendedBy", fields: [suspendedById], references: [id], onDelete: SetNull)
  // Phase 11 — Volunteer Marketplace
  marketplaceVisible         Boolean                  @default(false) // Org opts in to cross-org marketplace listing
  description                String? // Short org description shown on discovery page
  location                   String? // Display location, e.g. "Fresno, CA"
  causeAreaTags              String[]                 @default([]) // e.g. ["Environment", "Education"]
  verified                   Boolean                  @default(false) // Platform-verified org (set by platform admin)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  members                    OrganizationMember[]
  auditLogs                  AuditLog[]
  featureFlags               FeatureFlag[]
  applications               VolunteerApplication[]
  screenerQuestions          ScreenerQuestion[]
  sessions                   Session[] // optional backrelation
  invitations                OrganizationInvitation[]
  opportunities              VolunteerOpportunity[]
  credentials                VolunteerCredential[]
  sharedCredentials          VolunteerCredential[]    @relation("SharedCredentials")
  claimedShareTokens         CredentialShareToken[]   @relation("ClaimedShareTokens")
  shifts                     Shift[]
  shiftTemplates             ShiftTemplate[]
  companyLinks               CompanyNonprofitLink[]
  backgroundCheckRequests    BackgroundCheckRequest[]
  orgVolunteers              OrgVolunteer[]
  orgVolunteerBlocks         OrgVolunteerBlock[]
  volunteerInvitations       VolunteerInvitation[]
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  digestPreferences          UserDigestPreference[]
  bulkImportJobs             BulkImportJob[]
  feedbacks                  OrgFeedback[]
  userFeedbacks              UserFeedback[]
  slugHistory                OrgSlugHistory[]

  @@index([suspendedAt])
}

// Past org slugs kept so old public apply links (/apply/{oldSlug}) can redirect
// to the current slug instead of 404ing. Rows persist indefinitely; lookups
// check current slugs first, so a re-claimed slug wins over history.
model OrgSlugHistory {
  id        String   @id @default(cuid())
  orgId     String
  oldSlug   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([oldSlug])
  @@index([orgId])
}

model OrganizationMember {
  id                      String    @id @default(cuid())
  organizationId          String
  userId                  String
  role                    Role      @default(STAFF)
  lastActivityAt          DateTime?
  lastReengagementSegment String?
  createdAt               DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([lastActivityAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  orgId      String?
  companyId  String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  organization   Organization?   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  companyAccount CompanyAccount? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor          User?           @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([orgId, createdAt])
  @@index([actorId])
  @@index([entityId])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  orgId       String
  key         String
  enabled     Boolean  @default(false)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  updatedBy    User?        @relation("FeatureFlagUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([orgId, key])
}

model VolunteerApplication {
  id                String            @id @default(cuid())
  orgId             String
  opportunityId     String?
  submittedByUserId String?
  submittedByEmail  String
  status            ApplicationStatus @default(SUBMITTED)
  screeningStatus   ScreeningStatus   @default(REVIEW)
  screeningReasons  Json              @default("[]")
  submittedAt       DateTime          @default(now())
  source            ApplicationSource @default(DIRECT)

  /// Set when the owner of `submittedByEmail` says an orphan application is not
  /// theirs. `screener.submit` is public, so anyone can plant a row bearing
  /// someone else's address; declining is how that person makes it go away.
  /// Terminal — a declined row is never offered for claiming again.
  ///
  /// Two columns rather than a join table: `User.email` is unique and
  /// canonicalized and claimability is email equality, so for any given orphan
  /// row there is exactly ONE user who could ever claim it. A join table would
  /// model a many-to-many that cannot exist.
  declinedByUserId String?
  declinedAt       DateTime?

  organization    Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  opportunity     VolunteerOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  submittedByUser User?                 @relation("SubmittedApplications", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  declinedByUser  User?                 @relation("DeclinedApplications", fields: [declinedByUserId], references: [id], onDelete: SetNull)
  answers         VolunteerAnswer[]

  @@index([orgId, status])
  @@index([submittedByUserId])
  @@index([opportunityId])
  @@index([declinedByUserId])
  // Plus a hand-written PARTIAL index Prisma cannot express, covering the
  // claimable lookup: ("submittedByEmail") WHERE "submittedByUserId" IS NULL AND
  // "declinedAt" IS NULL. See the 20260727210100 migration — before it that
  // query had no usable index at all and scanned the whole table.
}

model VolunteerAnswer {
  id            String @id @default(cuid())
  applicationId String
  questionId    String
  answerJson    Json

  application VolunteerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model ScreenerQuestion {
  id               String               @id @default(cuid())
  orgId            String
  key              String
  prompt           String
  type             ScreenerQuestionType
  disqualifierJson Json?
  configJson       Json
  isActive         Boolean              @default(true)
  isTemplate       Boolean              @default(false)
  order            Int
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@index([orgId, isActive, order])
  @@index([isTemplate])
}

enum ApplicationStatus {
  SUBMITTED
  REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ApplicationSource {
  DIRECT
  MARKETPLACE
  REFERRAL
  WIDGET
}

enum ScreeningStatus {
  PASS
  REVIEW
  FAIL
}

enum ScreenerQuestionType {
  TEXT
  SINGLE_CHOICE
  MULTI_CHOICE
  BOOLEAN
  NUMBER
}

model OrganizationInvitation {
  id        String    @id @default(cuid())
  orgId     String
  email     String
  role      Role      @default(STAFF)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([orgId])
  @@index([expiresAt])
}

enum Role {
  OWNER
  ADMIN
  STAFF
  READONLY
}

enum OpportunityStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum RequirementLevel {
  REQUIRED
  PREFERRED
}

enum GeocodeStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
}

model VolunteerOpportunity {
  id              String                   @id @default(cuid())
  orgId           String
  title           String
  description     String
  status          OpportunityStatus        @default(DRAFT)
  location        String?
  isRemote        Boolean                  @default(false)
  startDate       DateTime?
  endDate         DateTime?
  commitmentHours Float?
  capacity        Int?
  lat             Float?
  lng             Float?
  geocodeStatus   GeocodeStatus            @default(PENDING)
  searchVector    Unsupported("tsvector")? // GIN-indexed; maintained by trg_opportunity_search_vector (includes title, description, tags)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  organization         Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tags                 OpportunityTag[]
  requirements         OpportunityRequirement[]
  applications         VolunteerApplication[]
  shifts               Shift[]
  shiftTemplates       ShiftTemplate[]
  volunteerInvitations VolunteerInvitation[]
  interests            OpportunityInterest[]

  @@index([orgId])
  @@index([status])
  @@index([status, geocodeStatus])
  @@index([status, createdAt])
}

model OpportunityTag {
  id            String @id @default(cuid())
  opportunityId String
  name          String

  opportunity VolunteerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, name])
  @@index([opportunityId])
}

model OpportunityRequirement {
  id            String           @id @default(cuid())
  opportunityId String
  skillId       String?
  familyId      String?
  level         RequirementLevel @default(REQUIRED)

  opportunity VolunteerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  skill       Skill?               @relation(fields: [skillId], references: [id], onDelete: Cascade)
  family      SkillFamily?         @relation(fields: [familyId], references: [id], onDelete: Cascade)

  // Partial unique indexes added via raw SQL in migration (nullable FKs)
  @@index([opportunityId])
  @@index([skillId])
  @@index([familyId])
}

model SkillFamily {
  id           String                   @id @default(cuid())
  name         String                   @unique
  slug         String                   @unique
  isActive     Boolean                  @default(true)
  order        Int                      @default(0)
  skills       Skill[]
  requirements OpportunityRequirement[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([isActive, order])
}

model Skill {
  id              String                   @id @default(cuid())
  name            String                   @unique
  slug            String                   @unique
  familyId        String
  isActive        Boolean                  @default(true)
  order           Int                      @default(0)
  family          SkillFamily              @relation(fields: [familyId], references: [id])
  volunteerSkills VolunteerSkill[]
  requirements    OpportunityRequirement[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([familyId])
  @@index([isActive, order])
}

model VolunteerSkill {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@unique([userId, skillId])
  @@index([userId])
}

model VolunteerProfile {
  id           String            @id @default(cuid())
  userId       String            @unique
  bio          String?
  phone        String?
  city         String?
  state        String?
  country      String?
  availability AvailabilityType  @default(FLEXIBLE)
  visibility   ProfileVisibility @default(ORGS_ONLY)
  interests    String[]          @default([])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Phase 7 — indexes for volunteer discovery search
  @@index([visibility])
  @@index([city, state])
}

enum AvailabilityType {
  WEEKDAYS
  WEEKENDS
  EVENINGS
  FLEXIBLE
}

enum ProfileVisibility {
  PUBLIC
  ORGS_ONLY
  PRIVATE
}

model VolunteerCredential {
  id                     String           @id @default(cuid())
  userId                 String
  orgId                  String
  type                   CredentialType
  status                 CredentialStatus @default(PENDING)
  issuedAt               DateTime?
  expiresAt              DateTime?
  notes                  String?
  issuedById             String?
  // Phase 6C — provenance: tracks origin when credential was shared from another org
  sharedFromOrgId        String?
  sharedFromCredentialId String?
  // When staff were last warned this credential is approaching expiry, written
  // by notifyStaffOfExpiringCredentials. It is the idempotency gate, but read
  // through credentialNoticeCycleStart() rather than as a bare null check: a
  // stamp older than one warning window describes an expiry date the row no
  // longer has, so a RENEWED credential is warned about again. Clearable by
  // `pnpm credentials:reset-notice` when a run delivered nothing.
  notifiedAt             DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization           Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sharedFromOrg          Organization?           @relation("SharedCredentials", fields: [sharedFromOrgId], references: [id], onDelete: SetNull)
  backgroundCheckRequest BackgroundCheckRequest?
  shareTokens            CredentialShareToken[]

  @@unique([userId, orgId, type])
  @@index([userId])
  @@index([orgId])
  // Phase 7 — index for volunteer discovery (filter by verified credentials)
  @@index([userId, status])
  // Serves BOTH credential-expiry cron queries, neither of which any other
  // index reaches: findExpiredCredentials (status + expiresAt < now) and the
  // expiry-notice scan (status + expiresAt in window). The three indexes above
  // are all keyed on userId first, so a table-wide scan by status could not use
  // them. Equality column first, range column second.
  //
  // A PARTIAL companion, VolunteerCredential_notice_due_idx, exists in the
  // migration only — Prisma has no syntax for a partial index, so it cannot be
  // declared here. Do not "tidy up" the extra index you see in the database.
  @@index([status, expiresAt])
}

enum CredentialType {
  BACKGROUND_CHECK
  TRAINING_COMPLETE
  ID_VERIFIED
  REFERENCE_CHECK
  ORIENTATION_COMPLETE
  // Phase 7 — Tenure badges (issued by platform org)
  TENURE_1YR
  TENURE_3YR
  TENURE_5YR
}

enum CredentialStatus {
  PENDING
  VERIFIED
  EXPIRED
  REVOKED
}

// ---------------------------------------------------------------------------
// Phase 5 — Scheduling & Shifts
// ---------------------------------------------------------------------------

model ShiftTemplate {
  id            String   @id @default(cuid())
  orgId         String
  title         String
  description   String?
  location      String?
  isRemote      Boolean  @default(false)
  dayOfWeek     Int // 0=Sunday, 1=Monday, ..., 6=Saturday
  startHour     Int // 0-23
  startMinute   Int // 0-59
  endHour       Int // 0-23
  endMinute     Int // 0-59
  capacity      Int
  opportunityId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  opportunity  VolunteerOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  shifts       Shift[]

  @@index([orgId])
}

model Shift {
  id            String      @id @default(cuid())
  orgId         String
  opportunityId String?
  templateId    String?
  title         String
  description   String?
  location      String?
  latitude      Float?
  longitude     Float?
  isRemote      Boolean     @default(false)
  startTime     DateTime
  endTime       DateTime
  capacity      Int
  status        ShiftStatus @default(OPEN)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  organization Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  opportunity  VolunteerOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  template     ShiftTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  signups      ShiftSignup[]

  @@index([orgId])
  @@index([opportunityId])
  @@index([templateId])
  @@index([orgId, startTime])
  @@index([status])
  @@index([status, endTime])
}

enum ShiftStatus {
  OPEN
  FULL
  CANCELLED
  COMPLETED
}

model ShiftSignup {
  id             String       @id @default(cuid())
  shiftId        String
  userId         String
  status         SignupStatus @default(CONFIRMED)
  notes          String?
  reminderSentAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shiftId, userId])
  @@index([shiftId])
  @@index([userId])
}

enum SignupStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
  NO_SHOW
  ATTENDED
}

// ---------------------------------------------------------------------------
// Phase 6A — Employer Accounts & Billing
// ---------------------------------------------------------------------------

enum PlanTier {
  FREE
  STARTER
  PRO
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum CompanyNonprofitLinkStatus {
  ACTIVE
  PAUSED
}

model CompanyAccount {
  id                   String                 @id @default(cuid())
  name                 String
  slug                 String                 @unique
  stripeCustomerId     String?                @unique
  stripeSubscriptionId String?                @unique
  planTier             PlanTier               @default(FREE)
  trialEndsAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  members              CompanyMember[]
  invitations          CompanyInvitation[]
  nonprofitLinks       CompanyNonprofitLink[]
  sessions             Session[]
  auditLogs            AuditLog[]
}

model CompanyMember {
  id        String            @id @default(cuid())
  companyId String
  userId    String
  role      CompanyMemberRole @default(MEMBER)
  createdAt DateTime          @default(now())

  company CompanyAccount @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
}

model CompanyInvitation {
  id        String            @id @default(cuid())
  companyId String
  email     String
  role      CompanyMemberRole @default(MEMBER)
  tokenHash String            @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  company CompanyAccount @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([companyId])
  @@index([expiresAt])
}

model CompanyNonprofitLink {
  id        String                     @id @default(cuid())
  companyId String
  orgId     String
  status    CompanyNonprofitLinkStatus @default(ACTIVE)
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  company CompanyAccount @relation(fields: [companyId], references: [id], onDelete: Cascade)
  org     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([companyId, orgId])
  @@index([companyId])
  @@index([orgId])
}

model StripeWebhookEvent {
  id          String   @id @default(cuid())
  stripeId    String   @unique // evt_... — idempotency key; UNIQUE constraint is the safety net
  type        String
  processedAt DateTime @default(now())
  payload     Json
}

// ---------------------------------------------------------------------------
// Phase 6B — Background Check Integration
// ---------------------------------------------------------------------------

enum BackgroundCheckProvider {
  CHECKR
  STERLING
}

enum BackgroundCheckStatus {
  PENDING
  COMPLETE
  CONSIDER
  FAILED
  CANCELLED
}

enum FcraStatus {
  NONE
  PRE_ADVERSE_SENT
  ADVERSE_ACTION_SENT
  RESOLVED
}

model BackgroundCheckRequest {
  id                     String                  @id @default(cuid())
  orgId                  String
  userId                 String
  provider               BackgroundCheckProvider @default(CHECKR)
  externalId             String                  @unique // Checkr report ID — idempotency key
  status                 BackgroundCheckStatus   @default(PENDING)
  webhookPayload         Json? // sanitized (no PII fields)
  credentialId           String?                 @unique
  fcraStatus             FcraStatus              @default(NONE)
  preAdverseNoticeSentAt DateTime?
  adverseActionAt        DateTime?
  /// The coordinator's attestation that they hold this volunteer's signed FCRA
  /// disclosure and authorization. Verifies NOTHING — the platform cannot see a
  /// paper form. Its value is turning the obligation /terms §4 already assigns
  /// to the org ("Obtaining appropriate consent from volunteers before
  /// initiating background checks") into a per-check record with a named actor,
  /// which is what an incident review or a dispute needs.
  ///
  /// Nullable and deliberately NOT backfilled: rows written before v0.40.0.0
  /// carry no attestation because none was ever asked for, and inventing one
  /// would manufacture evidence about a real person's consent.
  consentAttestedAt      DateTime?
  /// A plain String, not a User relation. `AuditLog.actorId` is `onDelete:
  /// SetNull`, which is right for an audit trail keyed on a live actor, and
  /// wrong here: this is EVIDENCE, and an attestation that empties itself when
  /// the coordinator who made it leaves the org is worthless in exactly the
  /// dispute it exists for.
  consentAttestedBy      String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  organization Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential   VolunteerCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([userId])
  @@index([orgId, status])
}

model CheckrWebhookEvent {
  id          String   @id @default(cuid())
  checkrId    String   @unique // idempotency key — mirrors StripeWebhookEvent.stripeId
  type        String
  processedAt DateTime @default(now())
  payload     Json // sanitized (no PII fields)
}

