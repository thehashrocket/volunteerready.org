{
	"name": "volunteeermatch-app",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "cross-env PORT=3005 next dev --turbo",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"format": "biome format src tests docs scripts prisma/schema.prisma --write",
		"check": "biome check src tests docs scripts prisma/schema.prisma --write",
		"seed": "ts-node --project prisma/tsconfig.json prisma/seed.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "git config core.hooksPath .githooks",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.2.2",
		"@next-auth/prisma-adapter": "^1.0.7",
		"@prisma/adapter-pg": "^7.5.0",
		"@prisma/client": "^7.5.0",
		"@prisma/client-runtime-utils": "^7.5.0",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-radio-group": "^1.3.8",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-slot": "^1.2.4",
		"@tanstack/react-query": "^5.90.21",
		"@trpc/client": "^11.12.0",
		"@trpc/react-query": "^11.12.0",
		"@trpc/server": "^11.12.0",
		"@vercel/analytics": "^1.6.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cross-env": "^10.1.0",
		"lucide-react": "^0.563.0",
		"next": "16.1.5",
		"next-auth": "^4.24.13",
		"nodemailer": "^7.0.13",
		"pg": "^8.20.0",
		"radix-ui": "^1.4.3",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-hook-form": "^7.71.2",
		"resend": "^4.8.0",
		"sonner": "^2.0.7",
		"superjson": "^2.2.6",
		"tailwind-merge": "^3.5.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@tailwindcss/postcss": "^4.2.1",
		"@types/node": "^20.19.37",
		"@types/pg": "8.11.11",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"dotenv": "^17.3.1",
		"prisma": "^7.5.0",
		"tailwindcss": "^4.2.1",
		"ts-node": "^10.9.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vitepress": "^1.6.4",
		"vitest": "^4.0.18"
	},
	"prisma": {
		"seed": "node prisma/seed.cjs"
	},
	"pnpm": {
		"overrides": {
			"@types/pg": "8.11.11"
		}
	}
}