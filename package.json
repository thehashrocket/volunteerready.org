{
	"name": "volunteeermatch-app",
	"version": "0.45.1.0",
	"private": true,
	"engines": {
		"node": "24.x"
	},
	"packageManager": "pnpm@12.16.1",
	"scripts": {
		"dev": "cross-env PORT=3005 next dev --turbo",
		"postinstall": "prisma generate",
		"build": "sh scripts/vercel-build.sh",
		"start": "next start",
		"lint": "biome check . --error-on-warnings",
		"format": "biome format . --write",
		"check": "biome check . --write --error-on-warnings",
		"seed": "tsx prisma/seed.ts",
		"seed:production": "cross-env NODE_ENV=production tsx prisma/seed-production.ts",
		"seed:dev": "tsx prisma/seed-dev.ts",
		"backfill:activity": "tsx scripts/backfill-activity.ts",
		"backfill:default-questions": "tsx scripts/backfill-default-questions.ts",
		"script:geocode-backfill": "tsx scripts/geocode-backfill.ts",
		"check:email-collisions": "tsx scripts/check-email-collisions.ts",
		"import:roster": "tsx scripts/import-roster.ts",
		"fixture:email-collisions": "tsx scripts/seed-email-collision-fixture.ts",
		"reencrypt-tokens": "tsx scripts/reencrypt-tokens.ts",
		"credentials:reset-notice": "tsx scripts/reset-credential-expiry-notice.ts",
		"admin:grant": "tsx scripts/admin-grant.ts",
		"admin:revoke": "tsx scripts/admin-grant.ts --revoke",
		"seed:platform-admins": "tsx prisma/scripts/seed-platform-admins.ts",
		"typecheck": "tsc --noEmit",
		"typecheck:tests": "tsc --noEmit --project tsconfig.tests.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:scripts": "vitest run --config vitest.scripts.config.ts",
		"test:integration": "vitest run --config vitest.integration.config.mts",
		"e2e": "playwright test",
		"screenshots": "cross-env CAPTURE=1 playwright test --project=capture",
		"prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"check:stranded-unclaimed": "tsx scripts/check-stranded-unclaimed.ts"
	},
	"dependencies": {
		"@hookform/resolvers": "^6.0.2",
		"@next-auth/prisma-adapter": "^1.0.7",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"@prisma/client-runtime-utils": "^7.10.1",
		"@radix-ui/react-dropdown-menu": "^2.2.1",
		"@radix-ui/react-label": "^2.1.17",
		"@radix-ui/react-radio-group": "^1.5.1",
		"@radix-ui/react-select": "^2.4.1",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-tabs": "^1.2.1",
		"@radix-ui/react-tooltip": "^1.4.1",
		"@react-pdf/renderer": "^4.9.0",
		"@sentry/nextjs": "^11.10.0",
		"@sentry/replay": "^11.10.0",
		"@tanstack/react-query": "^5.105.2",
		"@trpc/client": "^11.22.1",
		"@trpc/react-query": "^11.22.1",
		"@trpc/server": "^11.22.1",
		"@upstash/ratelimit": "^2.2.0",
		"@upstash/redis": "^1.41.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/functions": "^3.10.5",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"cross-env": "^10.1.0",
		"html5-qrcode": "^2.3.8",
		"leaflet": "^1.9.4",
		"lucide-react": "^1.66.0",
		"next": "~16.4.4",
		"next-auth": "^4.24.15",
		"next-themes": "^0.4.6",
		"nodemailer": "^10.3.1",
		"pg": "^8.23.1",
		"qrcode.react": "^4.2.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-hook-form": "^7.91.0",
		"react-leaflet": "^5.0.0",
		"resend": "^6.37.0",
		"sonner": "^2.0.8",
		"stripe": "^23.1.0",
		"superjson": "^2.2.6",
		"tailwind-merge": "^3.7.0",
		"vaul": "^1.1.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@playwright/test": "^1.65.0",
		"@storybook/addon-themes": "^10.6.6",
		"@storybook/react": "^10.6.6",
		"@storybook/react-vite": "^10.6.6",
		"@tailwindcss/postcss": "^4.3.4",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"dotenv": "^18.0.9",
		"jsdom": "^30.1.3",
		"prisma": "^7.10.1",
		"storybook": "^10.6.6",
		"tailwindcss": "^4.3.4",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.6",
		"vitepress": "^1.6.4",
		"vitest": "^5.1.0"
	},
	"prisma": {
		"seed": "node prisma/seed.cjs"
	}
}
